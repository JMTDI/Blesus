{
  "productName": "Blesus",
  "version": "0.2.1",
  "identifier": "com.opencursus.app",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Blesus",
        "width": 1280,
        "height": 840,
        "minWidth": 960,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false,
        "decorations": false,
        "dragDropEnabled": false,
        "center": true,
        "focus": true,
        "visible": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self' blob: 'wasm-unsafe-eval' https://cdn.jsdelivr.net; worker-src blob:; style-src 'self' 'unsafe-inline'; connect-src 'self' http://ipc.localhost https://api.resend.com; img-src 'self' data: blob: https: http:; media-src 'self' blob:"
    },
    "trayIcon": null
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico",
      "icons/icon.png"
    ],
    "linux": {
      "deb": {
        "depends": ["libayatana-appindicator3-1 | libappindicator3-1"],
        "desktopTemplate": "linux/desktop.template",
        "files": {
          "usr/share/icons/hicolor/32x32/apps/blesus.png": "icons/32x32.png",
          "usr/share/icons/hicolor/64x64/apps/blesus.png": "icons/64x64.png",
          "usr/share/icons/hicolor/128x128/apps/blesus.png": "icons/128x128.png",
          "usr/share/icons/hicolor/256x256/apps/blesus.png": "icons/icon.png"
        }
      },
      "rpm": {
        "desktopTemplate": "linux/desktop.template"
      }
    }
  },
  "plugins": {}
}
